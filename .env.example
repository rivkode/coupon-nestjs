# 인프라는 이 리포의 docker-compose.yml 이 띄운다 (`docker compose up -d`).
# 호스트에서 돌고 있는 다른 프로젝트(jamo 등)와 겹치지 않도록 포트를 옮겨 두었다.
# 컨테이너 내부 포트와 스키마 이름은 원본과 동일하다.

DB_HOST=localhost
DB_USER=promotion
DB_PASSWORD=promotion

# ADR-006 Database per Service — a 와 c 는 서로 다른 인스턴스다.
DB_PORT_A=3306
DB_NAME_A=server_a
DB_PORT_C=3307
DB_NAME_C=server_c

# HikariCP maximum-pool-size: 10 (측정값 — 근거 없이 올리지 말 것)
# 이름은 원본과 동일해야 한다 — docker-compose / 부하테스트 스크립트가 이 키로 주입한다.
HIKARI_POOL_SIZE=10

# 원본 6379 → 6381 (jamo-redis 가 6380 을 쓴다)
REDIS_HOST=localhost
REDIS_PORT=6381

# 원본 29092 → 29093
KAFKA_BOOTSTRAP=localhost:29093
