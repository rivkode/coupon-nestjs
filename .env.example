# 인프라는 이 리포의 docker-compose.yml 이 띄운다 (`docker compose up -d`).
# 호스트에서 돌고 있는 다른 프로젝트(jamo 등)와 겹치지 않도록 포트를 옮겨 두었다.
# 컨테이너 내부 포트와 스키마 이름은 원본과 동일하다.

DB_HOST=localhost
DB_USER=promotion
DB_PASSWORD=promotion

# ADR-006 Database per Service — a 와 c 는 서로 다른 인스턴스다.
DB_PORT_A=3306
DB_NAME_A=server_a
DB_PORT_C=3307
DB_NAME_C=server_c

# HikariCP maximum-pool-size: 10 (측정값 — 근거 없이 올리지 말 것)
# 이름은 원본과 동일해야 한다 — docker-compose / 부하테스트 스크립트가 이 키로 주입한다.
HIKARI_POOL_SIZE=10

# 원본 6379 → 6381 (jamo-redis 가 6380 을 쓴다)
REDIS_HOST=localhost
REDIS_PORT=6381

# 원본 29092 → 29093
KAFKA_BOOTSTRAP=localhost:29093

# ── server-c 튜닝 수치 (원본 application.yml 에서 이관 — 부하 테스트 산물이다) ──
# ADR-002 Outbox poller
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
# 평가항목 ③ — refresh(60s) < ttl(300s) 라 TTL 만료 자체가 오지 않는다 (stampede 차단)
EVENT_CACHE_TTL_SECONDS=300
EVENT_CACHE_REFRESH_MS=60000
# ADR-011 SOLD_OUT negative cache
COUPON_AVAILABLE_TTL_SECONDS=86400
# ADR-009 consumer throttle — 1 vCPU MySQL-C 의 비관적 락 처리량 보호
KAFKA_MAX_POLL_RECORDS=10
KAFKA_CONSUMER_CONCURRENCY=1
KAFKA_SEND_TIMEOUT_MS=3000
KAFKA_TOPIC_ISSUE_REQUEST=coupon-issue-request
KAFKA_TOPIC_ISSUE_RESULT=coupon-issue-result
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_RF=1
# Redis (원본 server-c: timeout / connect-timeout 1000ms)
REDIS_TIMEOUT_MS=1000
REDIS_CONNECT_TIMEOUT_MS=1000

# 통합 테스트 전용 스키마 (개발 DB 오염 방지)
DB_NAME_C_TEST=server_c_test
