{
  "name": "coupon-api-nestjs",
  "version": "0.0.1",
  "description": "Java/Spring promotion-event 를 NestJS + TypeORM 으로 포팅한 선착순 쿠폰 시스템",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build server-a && nest build server-b && nest build server-c",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"migrations/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware apps/ libs/ migrations/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "build:a": "nest build server-a",
    "build:b": "nest build server-b",
    "build:c": "nest build server-c",
    "start:a": "nest start server-a --watch",
    "start:b": "nest start server-b --watch",
    "start:c": "nest start server-c --watch",
    "start:prod:a": "node dist/apps/server-a/src/main",
    "start:prod:b": "node dist/apps/server-b/src/main",
    "start:prod:c": "node dist/apps/server-c/src/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:a": "typeorm-ts-node-commonjs migration:run -d migrations/server-a/data-source.ts",
    "migration:c": "typeorm-ts-node-commonjs migration:run -d migrations/server-c/data-source.ts",
    "migration:revert:a": "typeorm-ts-node-commonjs migration:revert -d migrations/server-a/data-source.ts",
    "migration:revert:c": "typeorm-ts-node-commonjs migration:revert -d migrations/server-c/data-source.ts",
    "prebuild": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.1",
    "@prometheus-io/client": "^0.16.1",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cockatiel": "^4.0.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dotenv": "^18.0.1",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
