{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/server-a",
  "sourceRoot": "apps/server-a/src",
  "compilerOptions": {
    "webpack": false,
    "deleteOutDir": false,
    "tsConfigPath": "apps/server-a/tsconfig.app.json"
  },
  "projects": {
    "server-a": {
      "type": "application",
      "root": "apps/server-a",
      "entryFile": "main",
      "sourceRoot": "apps/server-a/src",
      "compilerOptions": {
        "tsConfigPath": "apps/server-a/tsconfig.app.json"
      }
    },
    "server-b": {
      "type": "application",
      "root": "apps/server-b",
      "entryFile": "main",
      "sourceRoot": "apps/server-b/src",
      "compilerOptions": {
        "tsConfigPath": "apps/server-b/tsconfig.app.json"
      }
    },
    "server-c": {
      "type": "application",
      "root": "apps/server-c",
      "entryFile": "main",
      "sourceRoot": "apps/server-c/src",
      "compilerOptions": {
        "tsConfigPath": "apps/server-c/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}
